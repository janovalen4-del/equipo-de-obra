# Copiá este archivo a `.env.local` (desarrollo) y completá los valores.

# ============================================================
# Públicas (prefijo NEXT_PUBLIC_, visibles en el navegador)
# ============================================================

# Número de WhatsApp en formato internacional, sin +, espacios ni guiones.
# Ejemplo argentino: 54911XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Teléfono visible (opcional).
NEXT_PUBLIC_PHONE=

# Email de contacto (opcional).
NEXT_PUBLIC_EMAIL=

# URL canónica del sitio en producción (sin barra final).
NEXT_PUBLIC_SITE_URL=https://equipodeobra.com.ar

# En true, muestra "Sitio de demostración" en el footer.
NEXT_PUBLIC_IS_DEMO=true

# ============================================================
# Base de datos
# ============================================================
# Va en `.env` (lo lee el CLI de Prisma), NO en `.env.local`.
#   Local:  DATABASE_URL="file:./dev.db"
#   Producción (Postgres): DATABASE_URL="postgresql://user:pass@host:5432/db"
#
# Después de cambiar el datasource, corré:
#   npx prisma db push   (crear/actualizar esquema)
#   npx prisma generate  (regenerar el cliente)

# ============================================================
# Panel de administración (/admin)
# ============================================================
ADMIN_USERNAME=
# Contraseña del panel. Usá una fuerte y única. No versionar.
ADMIN_PASSWORD=
# Clave para firmar la cookie de sesión. Generá una larga y aleatoria
# (ej. `openssl rand -base64 32`). No versionar.
AUTH_SECRET=

# ============================================================
# Email de notificación (Resend — https://resend.com)
# ============================================================
# Opcional. Sin RESEND_API_KEY las consultas solo se guardan en la base.
RESEND_API_KEY=
# Remitente verificado en Resend.
RESEND_FROM=Equipo de Obra <onboarding@resend.dev>
# Email del dueño que recibe las notificaciones.
RESEND_TO=
